# Copy to .env.local for local development, and set the same values on Vercel
# under Project → Settings → Environment Variables.

# Supabase project URL and anon key — Project Settings → API in the dashboard.
# Both are public by design: the anon key is sent to every visitor's browser,
# and what protects the data is the row-level security in supabase/migrations.
# The service_role key is NOT used by this site and must never be added here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address, used for canonical URLs and share links.
# Leave unset locally; set it once the domain points at this deployment.
NEXT_PUBLIC_SITE_URL=
